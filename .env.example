# Copier en .env (jamais commité) et remplir.
# Serveur ntfy : idéalement le vôtre (http://ntfy.lan), sinon https://ntfy.sh
GAZETTE_NTFY_SERVER=https://ntfy.sh
# Sujet ntfy : long et secret si serveur public (ex. sortie de : openssl rand -hex 16)
GAZETTE_NTFY_TOPIC=
# Jeton d'accès si le serveur ntfy en demande un
GAZETTE_NTFY_TOKEN=
# Adresse de la gazette vue depuis le téléphone (VPN / réseau local), sans / final
GAZETTE_BASE_URL=http://gazette.lan
# Traduction : adresse du LibreTranslate auto-hébergé (vide = pas de traduction)
GAZETTE_TRANSLATE_URL=
# Clé LibreTranslate si vous en avez activé une (sinon laisser vide)
GAZETTE_TRANSLATE_KEY=
# Bouton « Actualiser » (vide = pas de bouton) et port du service local
GAZETTE_REFRESH_PATH=/actualiser
GAZETTE_SERVE_PORT=8766
# Thème : auto (suit le téléphone), dark (toujours sombre), light (toujours clair)
GAZETTE_THEME=auto
